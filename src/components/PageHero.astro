---
import { lp, type Lang } from '../i18n';
import { t } from '../data/ui';
const { lang, h1, lead, crumbs = [] } = Astro.props as { lang: Lang; h1: string; lead?: string; crumbs?: { name: string; path: string }[] };
---
<div class="phero">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={lp(lang, '/')}>{t('home', lang)}</a>
      {crumbs.map((c, i) => (<><span aria-hidden="true"> / </span>{i === crumbs.length - 1 ? <span>{c.name}</span> : <a href={lp(lang, c.path)}>{c.name}</a>}</>))}
    </nav>
    <h1>{h1}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</div>
