---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FinalCta from '../components/FinalCta.astro';
import type { Lang } from '../i18n';
import { t } from '../data/ui';
import { site } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const title = lang === 'ar' ? 'رسالة المؤسس | نوزا العقارية' : 'Message from the Founder | NOZA Real Estate';
const description = lang === 'ar' ? 'رسالة محمد زاهد إقبال، مؤسس نوزا العقارية ورئيسها التنفيذي، عن رسالة الشركة ونهجها.' : 'A message from Muhammad Zahid Iqbal, founder and CEO of NOZA Real Estate, on the company’s mission and approach.';
const crumbs = [{ name: t('ceo_h1', lang), path: '/ceo-message/' }];
---
<Base lang={lang} path="/ceo-message/" title={title} description={description} crumbs={[{ name: t('home', lang), path: '/' }, ...crumbs]}>
  <PageHero lang={lang} h1={t('ceo_h1', lang)} crumbs={crumbs} />
  <section>
    <div class="wrap" style="max-inline-size:760px">
      <p class="lead">{t('ceo_p1', lang)}</p>
      <p>{t('ceo_p2', lang)}</p>
      <p><strong>{site.founder}</strong><br />{t('founder_role', lang)}<br />NOZA Real Estate</p>
    </div>
  </section>
  <FinalCta lang={lang} />
</Base>
